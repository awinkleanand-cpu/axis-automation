<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Pass Fail Demo Suite" verbose="2">
    <listeners>
        <listener class-name="com.axismaxlife.automation.listeners.TestListener"/>
    </listeners>
    <test name="10 Passing Scenarios">
        <classes>
            <class name="com.axismaxlife.tests.PassingScenariosTest"/>
        </classes>
    </test>
    <test name="10 Failing Scenarios">
        <classes>
            <class name="com.axismaxlife.tests.FailingScenariosTest"/>
        </classes>
    </test>
</suite>
